# =================================================================
# StudyTrack PaaS Environment Variables Template
# Copy this file to .env.local and fill in your values
# =================================================================

# 1. Supabase Database PaaS (https://supabase.com)
# Obtain from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Cloudinary Storage PaaS (https://cloudinary.com)
# Obtain from: Cloudinary Console > Settings > Upload Presets (enable Unsigned)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=studytrack_preset

# Optional: Cloudinary Server API (if using server-side signed uploads)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 3. Application Metadata
NEXT_PUBLIC_APP_NAME=StudyTrack
NEXT_PUBLIC_GITHUB_REPO=https://github.com/your-username/studytrack-paas
